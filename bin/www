#!/usr/bin/env node

/**
 * Module dependencies.
 */

 const config = require('../config/default.js');
const app = require('../index');
const debug = require('debug')('login-portal:server');
const https = require('https');
const http = require('http');
const fs = require('fs');


/**
 * Get port from environment and store in Express.
 */

// var port = normalizePort(process.env.PORT || '3030');
const port = config.PORT || 3030; // port of IoTMediator
app.set('port', port);


//===========================================================
// Create a HTTPs server
//===========================================================
app.set('port', port);
const httpsServer = https.createServer({
    key: fs.readFileSync(`${config.__basedir}/config/private.key`),
    cert: fs.readFileSync(`${config.__basedir}/config/certificate.crt`),
    ca: fs.readFileSync(`${config.__basedir}/config/ddrl.live.ca`)
}, app)
httpsServer.listen(port);
httpsServer.on('error', onError);
httpsServer.on('listening', onListening);


//===========================================================
// Create a HTTP server
//===========================================================

// const httpServer = http.createServer(app);
// httpServer.listen(3002, () => {
//     console.log(`HTTP Server listening on 3032`);
// });



//===========================================================
//  Normalize a port into a number, string, or false.
//===========================================================

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

//===========================================================
//  Event listener for HTTP server "error" event.
//===========================================================

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

//===========================================================
//  Event listener for HTTP server "listening" event.
//===========================================================

function onListening() {
  var addr = httpsServer.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
  console.log('Listening on ' + bind);
}
